# Copia este archivo a .env (local) y crea las mismas variables como "Secrets" en GitHub (Settings > Secrets > Actions).

# ===== Formulario → n8n =====
# URL de producción del nodo Webhook del workflow "GD Landing – Lead a CRM + Calendar" (n8n/lead-to-crm-calendar.json)
PUBLIC_N8N_WEBHOOK_URL=https://TU-N8N.dominio.com/webhook/gd-landing-lead

# ===== Google Calendar – Página de reservas (Agenda de citas) =====
# Google Calendar > Crear > Agenda de citas > Compartir > "Página de reservas" (https://calendar.app.google/xxxx)
PUBLIC_BOOKING_URL=

# ===== Google Tag Manager (opcional) =====
PUBLIC_GTM_ID=

# ===== Datos en build (solo los usa `npm run build`) =====
# Google Cloud > APIs y servicios > Credenciales > Clave de API (restringida a "Places API (New)")
GOOGLE_PLACES_API_KEY=
# Place ID de tu ficha: https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACE_ID=
# Instagram API with Instagram Login (token de larga duración, cuenta profesional)
INSTAGRAM_ACCESS_TOKEN=
