---
import '../styles/global.css';
import serif from '../assets/fonts/source-serif-4-latin-subset.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import { SITE } from '../config/site';
import { copy as c } from '../config/copy';
import { PUBLIC_GTM_ID } from 'astro:env/client';

interface Props {
  title: string;
  description: string;
  image?: string;
  schema?: object;
  noindex?: boolean;
  /** Texto al compartir (og:description). Si no se pasa, usa description. */
  ogDescription?: string;
}
const { title, description, image = '/og-english-school.jpg', schema, noindex = false, ogDescription } = Astro.props;
const shareDescription = ogDescription ?? description;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;
// noindex global mientras el cliente no apruebe (SITE.indexable = false)
const blockIndex = noindex || !SITE.indexable;
---
<!doctype html>
<html lang={c.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {blockIndex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}

    <!-- Solo se precarga la serif de títulos (el H1 es el LCP) -->
    <link rel="preload" href={serif} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#2f3185" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={c.ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={shareDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={shareDescription} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="geo.region" content="CO-ANT" />
    <meta name="geo.placename" content={`${SITE.address.city}, Antioquia`} />
    {SITE.geo && <meta name="geo.position" content={`${SITE.geo.lat};${SITE.geo.lng}`} />}
    {SITE.geo && <meta name="ICBM" content={`${SITE.geo.lat}, ${SITE.geo.lng}`} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    {PUBLIC_GTM_ID && (
      <script is:inline define:vars={{ GTM: PUBLIC_GTM_ID }}>
        // GTM diferido: se carga en la 1ª interacción o a los 4 s → no afecta LCP/INP/TBT
        window.dataLayer = window.dataLayer || [];
        (function () {
          var done = false;
          function load() {
            if (done) return; done = true;
            window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
            var s = document.createElement('script'); s.async = true;
            s.src = 'https://www.googletagmanager.com/gtm.js?id=' + GTM;
            document.head.appendChild(s);
          }
          ['pointerdown', 'keydown', 'scroll', 'touchstart'].forEach(function (e) { addEventListener(e, load, { once: true, passive: true }); });
          addEventListener('load', function () { setTimeout(load, 4000); });
        })();
      </script>
    )}
  </head>
  <body>
    <a class="skip" href="#main">Saltar al contenido</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <WhatsAppFab />
  </body>
</html>
