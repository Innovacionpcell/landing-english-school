---
import Icon from './Icon.astro';
import Brand from './Brand.astro';
import { SITE, socialLinks, whatsappUrl } from '../config/site';
import { copy } from '../config/copy';
const c = copy.footer;
const n = copy.nav;
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="container ftr__grid">
    <div class="ftr__brand">
      <Brand inverse />
      <p>{c.tagline}</p>
      <ul class="socials" aria-label={c.follow}>
        {socialLinks.map((s) => (
          <li><a href={s.url} target="_blank" rel="noopener me" aria-label={s.label}><Icon name={s.id} /></a></li>
        ))}
        <li><a href={whatsappUrl()} target="_blank" rel="noopener" aria-label="WhatsApp"><Icon name="whatsapp" /></a></li>
      </ul>
    </div>
    <nav aria-label={c.explore}>
      <p class="ftr__h">{c.explore}</p>
      <ul>
        <li><a href="/#programas">{n.programs}</a></li>
        <li><a href="/#metodologia">{n.method}</a></li>
        <li><a href="/#sedes">{n.coverage}</a></li>
        <li><a href="/#faq">{n.faq}</a></li>
        <li><a href="/#matricula">{n.cta}</a></li>
      </ul>
    </nav>
    <address class="ftr__nap">
      <p class="ftr__h">{c.contact}</p>
      <p><strong>{SITE.gbpName}</strong><br />{SITE.address.street}, {SITE.address.neighborhood}<br />{SITE.address.city}, {SITE.address.region}, Colombia</p>
      <p><a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a>{SITE.email && <><br /><a href={`mailto:${SITE.email}`}>{SITE.email}</a></>}</p>
      <p>{SITE.hoursDisplay}</p>
    </address>
  </div>
  <div class="container ftr__bottom">
    <p>© {year} {SITE.name}. {c.rights}</p>
    <p><a href="/privacidad/">{c.privacy}</a> · {c.credit} <a href="https://growthdigital.marketing/" target="_blank" rel="noopener">Growth Digital</a></p>
  </div>
</footer>
<style>
  .ftr { background: var(--navy-deep); color: #c9cbe6; padding-top: 64px; font-size: .96rem; border-top: 4px solid var(--red); }
  .ftr a { color: #eef0fb; text-decoration: none; }
  .ftr a:hover { color: #fff; text-decoration: underline; }
  .ftr__grid { display: grid; grid-template-columns: 1.4fr 1fr 1.2fr; gap: 40px; }
  .ftr__brand p { margin-top: 18px; max-width: 380px; }
  .ftr__h { font-family: var(--font-head); font-weight: 700; font-size: 1.08rem; color: #fff; margin-bottom: 14px; }
  .ftr ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .ftr address { font-style: normal; }
  .socials { display: flex !important; gap: 10px !important; flex-wrap: wrap; }
  .socials a { display: inline-flex; width: 44px; height: 44px; align-items: center; justify-content: center; border-radius: 12px; background: rgb(255 255 255 / .08); }
  .socials a:hover { background: var(--navy); text-decoration: none; }
  .socials :global(svg) { width: 20px; height: 20px; }
  .ftr__bottom { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; border-top: 1px solid rgb(255 255 255 / .1); margin-top: 48px; padding-block: 22px 96px; font-size: .88rem; }
  .ftr__bottom p { margin: 0; }
  @media (max-width: 820px) { .ftr__grid { grid-template-columns: 1fr; } }
</style>
