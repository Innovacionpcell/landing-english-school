---
import Icon from './Icon.astro';
import Wordmark from './Wordmark.astro';
import { SITE } from '../config/site';
import { t, localePath, type Lang } from '../i18n/copy';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t(lang);
const home = localePath(lang, '/');
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="container ftr__grid">
    <div class="ftr__brand">
      <Wordmark size={23} />
      <p>{c.footer.tagline}</p>
      <ul class="socials" aria-label={c.footer.follow}>
        {SITE.social.map((s) => (
          <li><a href={s.url} target="_blank" rel="noopener me" aria-label={s.label}><Icon name={s.id} /></a></li>
        ))}
      </ul>
    </div>
    <nav aria-label={c.footer.explore}>
      <p class="ftr__h">{c.footer.explore}</p>
      <ul>
        <li><a href={`${home}#soluciones`}>{c.nav.solutions}</a></li>
        <li><a href={`${home}#metodo`}>{c.nav.method}</a></li>
        <li><a href={`${home}#tecnologia`}>{c.nav.tech}</a></li>
        <li><a href="/blog/">{c.nav.blog}</a></li>
        <li><a href={SITE.portalUrl} target="_blank" rel="noopener" class="ftr__portal"><Icon name="portal" />{c.nav.portal}</a></li>
        <li><span class="soon">{c.footer.academy}</span></li>
      </ul>
    </nav>
    <address class="ftr__nap">
      <p class="ftr__h">{c.footer.contact}</p>
      <p><strong>{SITE.name}</strong><br />{SITE.address.street}<br />{SITE.address.neighborhood}, {SITE.address.city}, {SITE.address.region}, Colombia</p>
      <p><a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a><br /><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      <p>{c.contact.hours}</p>
    </address>
  </div>
  <div class="container ftr__bottom">
    <p>© {year} {SITE.name}. {c.footer.rights}</p>
    <a href="/privacidad/">{c.footer.privacy}</a>
  </div>
</footer>
<style>
  .ftr { background: #0b1220; color: #c3cad6; padding-top: 64px; font-size: .96rem; }
  .ftr a { color: #e6ebf3; text-decoration: none; }
  .ftr a:hover { color: #fff; text-decoration: underline; }
  .ftr__grid { display: grid; grid-template-columns: 1.4fr 1fr 1.2fr; gap: 40px; }
  .ftr__brand :global(.wm) { background: #fff; border-radius: 10px; padding: 8px 12px; box-sizing: content-box; }
  .ftr__brand p { margin-top: 18px; max-width: 360px; }
  .ftr__h { font-family: var(--font-head); font-weight: 700; color: #fff; margin-bottom: 14px; }
  .ftr ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .ftr address { font-style: normal; }
  .ftr__portal { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; color: #fff !important; }
  .ftr__portal :global(svg) { width: 18px; height: 18px; color: var(--yellow); }
  .soon { color: #fbbc05; font-weight: 500; }
  .socials { display: flex !important; gap: 10px !important; flex-wrap: wrap; }
  .socials a { display: inline-flex; width: 44px; height: 44px; align-items: center; justify-content: center; border-radius: 12px; background: rgb(255 255 255 / .08); }
  .socials a:hover { background: var(--blue); text-decoration: none; }
  .socials svg { width: 20px; height: 20px; }
  .ftr__bottom { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; border-top: 1px solid rgb(255 255 255 / .1); margin-top: 48px; padding-block: 22px 96px; font-size: .88rem; }
  .ftr__bottom p { margin: 0; }
  @media (max-width: 820px) { .ftr__grid { grid-template-columns: 1fr; } }
</style>
