---
import Base from '../layouts/Base.astro';
import Hero from './sections/Hero.astro';
import Why from './sections/Why.astro';
import Programs from './sections/Programs.astro';
import Method from './sections/Method.astro';
import About from './sections/About.astro';
import Coverage from './sections/Coverage.astro';
import Faq from './sections/Faq.astro';
import Contact from './sections/Contact.astro';
import { SITE } from '../config/site';
import { copy as c } from '../config/copy';
import { graph, organizationGraph, webPage, faqPage } from '../lib/schema';
const url = `${SITE.url}/`;
const schema = graph(organizationGraph(), webPage(url, c.meta.title, c.meta.description), faqPage(url));
---
<Base title={c.meta.title} description={c.meta.description} ogDescription={c.meta.ogDescription} schema={schema}>
  <Hero />
  <Programs />
  <Why />
  <Method />
  <Coverage />
  <About />
  <Faq />
  <Contact />
</Base>
