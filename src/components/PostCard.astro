---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { t, type Lang } from '../i18n/copy';
interface Props { post: CollectionEntry<'blog'>; lang: Lang; eager?: boolean }
const { post, lang, eager = false } = Astro.props;
const c = t(lang).blog;
const date = post.data.pubDate.toLocaleDateString(lang === 'es' ? 'es-CO' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const mins = Math.max(2, Math.round((post.body?.split(/\s+/).length ?? 400) / 220));
---
<article class="pc">
  <a href={`/blog/${post.id}/`} class="pc__link">
    {typeof post.data.cover === 'string' ? (
      <img src={post.data.cover} alt={post.data.coverAlt ?? ''} width="720" height="405" loading={eager ? 'eager' : 'lazy'} decoding="async" class="pc__img" />
    ) : post.data.cover && (
      <Image src={post.data.cover} alt={post.data.coverAlt ?? ''} widths={[360, 540, 720]} sizes="(max-width: 620px) 92vw, (max-width: 960px) 46vw, 360px" loading={eager ? 'eager' : 'lazy'} class="pc__img" />
    )}
    <div class="pc__body">
      <p class="pc__meta"><span class="pc__cat">{post.data.category}</span> · <time datetime={post.data.pubDate.toISOString()}>{date}</time> · {mins} {c.minutes}</p>
      <h3>{post.data.title}</h3>
      <p class="pc__desc">{post.data.description}</p>
      <span class="pc__more">{c.read} →</span>
    </div>
  </a>
</article>
<style>
  .pc { height: 100%; }
  .pc__link { display: flex; flex-direction: column; height: 100%; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; text-decoration: none; color: inherit; transition: transform .2s ease, box-shadow .2s ease; }
  .pc__link:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .pc__link :global(.pc__img) { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .pc__body { padding: 22px 24px 26px; display: flex; flex-direction: column; flex: 1; }
  .pc__meta { font-size: .84rem; color: var(--muted); margin-bottom: 10px; }
  .pc__cat { color: var(--blue); font-weight: 600; }
  .pc h3 { font-size: 1.18rem; margin-bottom: 8px; }
  .pc__desc { color: var(--muted); font-size: .98rem; flex: 1; }
  .pc__more { font-family: var(--font-head); font-weight: 700; color: var(--blue); font-size: .95rem; }
</style>
