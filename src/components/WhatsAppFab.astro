---
import Icon from './Icon.astro';
import { whatsappUrl } from '../config/site';
import { copy } from '../config/copy';
---
<a class="wa-fab" href={whatsappUrl()} target="_blank" rel="noopener" aria-label={copy.wa} data-cta="whatsapp-fab">
  <Icon name="whatsapp" />
</a>
<style>
  .wa-fab { position: fixed; right: 18px; bottom: 18px; z-index: 40; width: 58px; height: 58px; border-radius: 50%; display: grid; place-items: center; background: #25d366; color: #fff; box-shadow: 0 10px 28px rgb(37 211 102 / .45); transition: transform .15s ease; }
  .wa-fab:hover { transform: scale(1.06); }
  .wa-fab :global(svg) { width: 30px; height: 30px; }
</style>
