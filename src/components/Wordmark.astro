---
// Wordmark "Growth Digital" con los colores del logo, en texto real (accesible, indexable, 0 requests)
interface Props { size?: number }
const { size = 21 } = Astro.props;
const L: [string, string][] = [
  ['G', '#0386fb'], ['r', '#ff4234'], ['o', '#f5b400'], ['w', '#0386fb'], ['t', '#00a94f'], ['h', '#ff4234'],
  ['D', '#ff4234'], ['i', '#f5b400'], ['g', '#0386fb'], ['i', '#00a94f'], ['t', '#ff4234'], ['a', '#0386fb'], ['l', '#ff4234'],
];
---
<span class="wm" style={`font-size:${size}px`}>{L.map(([ch, c], i) => <span style={`color:${c}`}>{i === 6 ? ' ' : ''}{ch}</span>)}</span>
<style>
  .wm { display: inline-block; font-family: var(--font-head); font-weight: 800; letter-spacing: -0.01em; line-height: 1; white-space: nowrap; }
</style>
