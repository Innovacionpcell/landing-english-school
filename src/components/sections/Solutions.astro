---
import Icon from '../Icon.astro';
import { t, type Lang } from '../../i18n/copy';
const { lang } = Astro.props as { lang: Lang };
const c = t(lang).solutions;
---
<section class="section" id="soluciones">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">{c.eyebrow}</p>
      <h2>{c.title}</h2>
      <p class="lead">{c.lead}</p>
    </div>
    <ul class="grid sol">
      {c.items.map((s) => (
        <li class={`card sol__item dot--${s.color}`}>
          <span class="sol__ic"><Icon name={s.icon} /></span>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .sol { grid-template-columns: repeat(3, 1fr); list-style: none; padding: 0; margin: 0; }
  .sol__item { position: relative; transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease; }
  .sol__item:hover { transform: translateY(-4px); box-shadow: var(--shadow); border-color: color-mix(in srgb, var(--c) 40%, var(--line)); }
  .sol__item p { margin: 0; color: var(--muted); }
  .sol__ic { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 14px; margin-bottom: 18px; color: var(--c); background: color-mix(in srgb, var(--c) 11%, #fff); }
  .sol__ic :global(svg) { width: 26px; height: 26px; }
  @media (max-width: 960px) { .sol { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 620px) { .sol { grid-template-columns: 1fr; } }
</style>
