---
import { copy } from '../../config/copy';
const c = copy.about;
// TODO: cuando el cliente envíe fotos reales de la sede/clases, agregar <Picture> aquí (src/assets/sede/)
---
<section class="section" id="academia">
  <div class="container about">
    <div class="about__mark" aria-hidden="true">
      <span>ES</span>
    </div>
    <div>
      <p class="eyebrow">{c.eyebrow}</p>
      <h2>{c.title}</h2>
      <p>{c.p1}</p>
      <p>{c.p2}</p>
    </div>
  </div>
</section>
<style>
  .about { display: grid; grid-template-columns: 300px 1fr; gap: clamp(32px, 6vw, 72px); align-items: center; }
  .about p { font-size: 1.08rem; }
  .about__mark { aspect-ratio: 1; border-radius: 24px; background: var(--navy); display: grid; place-items: center; position: relative; overflow: hidden; box-shadow: var(--shadow-lg); }
  .about__mark::before { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 34%; background: repeating-linear-gradient(180deg, var(--red) 0 10px, #fff 10px 20px); opacity: .95; }
  .about__mark span { position: relative; font-family: var(--font-head); font-weight: 700; font-size: 6.5rem; color: #fff; line-height: 1; margin-bottom: 18%; }
  @media (max-width: 860px) { .about { grid-template-columns: 1fr; } .about__mark { width: min(56vw, 240px); } }
</style>
