---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import logo from '../../assets/brand/logo-icon.png';
import ig from '../../data/instagram.json';
import b1 from '../../assets/banners/seo-engranajes.jpg';
import b2 from '../../assets/andres/andres-vergara-circle.jpg';
import b3 from '../../assets/banners/diseno-web.jpg';
import { SITE } from '../../config/site';
import { t, type Lang } from '../../i18n/copy';
const { lang } = Astro.props as { lang: Lang };
const c = t(lang).instagram;
const url = `https://www.instagram.com/${SITE.instagramHandle}/`;
// Imágenes descargadas por scripts/fetch-instagram.mjs
const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/instagram/*.jpg', { eager: true });
type P = { id: string; file: string; permalink: string; caption: string };
const posts = (ig.posts as P[])
  .map((p) => ({ ...p, img: files[`../../assets/instagram/${p.file}`]?.default }))
  .filter((p) => p.img);
const fallback = [b1, b2, b3];
---
<section class="section ig" id="instagram">
  <div class="container ig__grid">
    <div class="ig__copy">
      <p class="eyebrow">{c.eyebrow}</p>
      <h2>{c.title}</h2>
      <p class="lead">{c.lead}</p>
      <a class="ig__profile" href={url} target="_blank" rel="noopener me">
        <span class="ig__av"><Image src={logo} alt="" width={48} height={54} /></span>
        <span><strong>@{SITE.instagramHandle}</strong><span>Growth Digital · Andrés Vergara</span></span>
      </a>
      <a class="btn ig__btn" href={url} target="_blank" rel="noopener me" data-cta="instagram"><Icon name="instagram" />{c.cta}</a>
    </div>
    <ul class="ig__feed">
      {posts.length
        ? posts.map((p) => (
            <li><a href={p.permalink} target="_blank" rel="noopener" aria-label={p.caption || 'Instagram'}>
              <Image src={p.img!} alt={p.caption || `Publicación de @${SITE.instagramHandle}`} widths={[200, 320]} sizes="(max-width: 700px) 30vw, 180px" loading="lazy" />
            </a></li>
          ))
        : fallback.map((img, i) => (
            <li><a href={url} target="_blank" rel="noopener" aria-label={`Instagram @${SITE.instagramHandle}`}>
              <Image src={img} alt="" widths={[240, 360]} sizes="(max-width: 700px) 30vw, 200px" loading="lazy" class={i === 1 ? 'pos-top' : ''} />
              <span class="ig__ov" aria-hidden="true"><Icon name="instagram" /></span>
            </a></li>
          ))}
    </ul>
  </div>
</section>
<style>
  .ig { background: linear-gradient(135deg, #fff 0%, #fff6f5 45%, #fffaf0 100%); }
  .ig__grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(32px, 6vw, 72px); align-items: center; }
  .ig__profile { display: flex; align-items: center; gap: 14px; text-decoration: none; color: var(--ink); margin: 8px 0 22px; }
  .ig__profile strong { display: block; font-family: var(--font-head); }
  .ig__profile span span { color: var(--muted); font-size: .92rem; }
  .ig__av { width: 64px; height: 64px; border-radius: 50%; display: grid; place-items: center; background: #fff; box-shadow: 0 0 0 3px #fff, 0 0 0 6px #e1306c; }
  .ig__av :global(img) { width: 36px; height: auto; }
  .ig__btn { background: linear-gradient(90deg, #c13584, #833ab4); }
  .ig__feed { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .ig__feed a { position: relative; display: block; aspect-ratio: 1; border-radius: 16px; overflow: hidden; background: var(--bg-soft); }
  .ig__feed :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .3s ease; }
  .ig__feed :global(img.pos-top) { object-position: top; }
  .ig__feed a:hover :global(img) { transform: scale(1.05); }
  .ig__ov { position: absolute; right: 10px; bottom: 10px; width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; background: rgb(255 255 255 / .9); color: #c13584; }
  .ig__ov :global(svg) { width: 18px; height: 18px; }
  @media (max-width: 860px) { .ig__grid { grid-template-columns: 1fr; } }
</style>
