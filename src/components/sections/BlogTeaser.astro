---
import { getCollection } from 'astro:content';
import PostCard from '../PostCard.astro';
import Icon from '../Icon.astro';
import { SITE } from '../../config/site';
import { t, type Lang } from '../../i18n/copy';
import { getSoroArticles } from '../../lib/soro';
const { lang } = Astro.props as { lang: Lang };
const c = t(lang).blog;

// Home: los 3 artículos más recientes del blog de Soro (HTML estático, sin JS).
// Si aún no hay artículos en Soro (o no respondió en el build) → destacados propios (featured: true).
const MAX = 3;
const soro = (await getSoroArticles()).slice(0, MAX);
const all = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const inLang = all.filter((p) => p.data.lang === lang);
const pool = inLang.length >= 3 ? inLang : all;
const featured = pool.filter((p) => p.data.featured);
const own = (featured.length >= 3 ? featured : [...featured, ...pool.filter((p) => !featured.includes(p))]).slice(0, MAX);
const author = `${SITE.founder.name} · ${SITE.name}`;
const fmt = (iso: string) => (iso ? new Date(iso).toLocaleDateString(lang === 'es' ? 'es-CO' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : '');
const show = soro.length > 0 || own.length > 0;
---
{show && (
  <section class="section section--soft" id="blog">
    <div class="container">
      <div class="bt__head">
        <div><p class="eyebrow">{c.eyebrow}</p><h2>{c.title}</h2></div>
        <a class="btn btn--ghost" href="/blog/">{c.all}<Icon name="arrow" /></a>
      </div>
      <ul class="grid bt__list">
        {soro.length > 0
          ? soro.map((a) => (
              <li>
                <article class="pc">
                  <a href={a.url} class="pc__link">
                    {a.image && <img src={a.image} alt={a.title} width="720" height="405" loading="lazy" decoding="async" class="pc__img" />}
                    <div class="pc__body">
                      <p class="pc__meta"><span class="pc__cat">{c.eyebrow}</span>{a.isoDate && <> · <time datetime={a.isoDate}>{fmt(a.isoDate)}</time></>}</p>
                      <h3>{a.title}</h3>
                      <p class="pc__desc">{a.excerpt}</p>
                      <p class="pc__by">{c.by} {author}</p>
                      <span class="pc__more">{c.read} →</span>
                    </div>
                  </a>
                </article>
              </li>
            ))
          : own.map((p) => <li><PostCard post={p} lang={lang} /></li>)}
      </ul>
      <p class="bt__foot"><a class="btn" href="/blog/">{c.all}<Icon name="arrow" /></a></p>
    </div>
  </section>
)}
<style>
  .bt__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; flex-wrap: wrap; margin-bottom: 36px; }
  .bt__head h2 { margin: 0; }
  .bt__list { grid-template-columns: repeat(3, 1fr); list-style: none; padding: 0; margin: 0; }
  .bt__foot { text-align: center; margin-top: 36px; }
  /* Tarjeta (misma apariencia que PostCard) */
  .pc { height: 100%; }
  .pc__link { display: flex; flex-direction: column; height: 100%; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; text-decoration: none; color: inherit; transition: transform .2s ease, box-shadow .2s ease; }
  .pc__link:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .pc__img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .pc__body { padding: 22px 24px 26px; display: flex; flex-direction: column; flex: 1; }
  .pc__meta { font-size: .84rem; color: var(--muted); margin-bottom: 10px; }
  .pc__cat { color: var(--blue); font-weight: 600; }
  .pc h3 { font-size: 1.18rem; margin-bottom: 8px; }
  .pc__desc { color: var(--muted); font-size: .98rem; flex: 1; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .pc__by { font-size: .84rem; color: var(--muted); margin: 10px 0 6px; }
  .pc__more { font-family: var(--font-head); font-weight: 700; color: var(--blue); font-size: .95rem; }
  @media (max-width: 960px) { .bt__list { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 620px) { .bt__list { grid-template-columns: 1fr; } .bt__head .btn { display: none; } }
</style>
