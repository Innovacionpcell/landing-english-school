---
import { t, type Lang } from '../../i18n/copy';
const { lang } = Astro.props as { lang: Lang };
const c = t(lang).faq;
---
<section class="section" id="faq">
  <div class="container faq">
    <div class="section__head section__head--center">
      <p class="eyebrow">{c.eyebrow}</p>
      <h2>{c.title}</h2>
    </div>
    <div class="faq__list">
      {c.items.map((f, i) => (
        <details name="faq" open={i === 0}>
          <summary><h3>{f.q}</h3></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .faq__list { max-width: 820px; margin-inline: auto; display: grid; gap: 12px; }
  details { border: 1px solid var(--line); border-radius: 16px; background: #fff; padding: 0 24px; transition: border-color .2s; }
  details[open] { border-color: #c6dafc; box-shadow: var(--shadow); }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 20px 0; }
  summary::-webkit-details-marker { display: none; }
  summary h3 { margin: 0; font-size: 1.08rem; }
  summary::after { content: '+'; flex: none; width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; background: #e8f0fe; color: var(--blue); font-size: 1.3rem; font-weight: 600; transition: transform .2s; }
  details[open] summary::after { transform: rotate(45deg); }
  details p { margin: 0 0 22px; color: var(--muted); }
</style>
