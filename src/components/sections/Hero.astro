---
import Icon from '../Icon.astro';
import { whatsappUrl } from '../../config/site';
import { copy } from '../../config/copy';
const c = copy.hero;
---
<section class="hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1>{c.h1a} <span class="hl">{c.h1b}</span></h1>
      <p class="lead">{c.sub}</p>
      <div class="hero__ctas">
        <a class="btn" href="#prueba" data-cta="hero"><Icon name="calendar" />{c.cta1}</a>
        <a class="btn btn--wa" href={whatsappUrl()} target="_blank" rel="noopener" data-cta="hero-wa"><Icon name="whatsapp" />{c.cta2}</a>
      </div>
      <ul class="proof">
        {c.badges.map((b) => <li><Icon name="check" class="ok" />{b}</li>)}
      </ul>
    </div>
    <aside class="hero__card" aria-labelledby="hero-card-t">
      <span class="stripes" aria-hidden="true"></span>
      <p class="hero__card-t" id="hero-card-t">{c.cardTitle}</p>
      <ol>
        {c.cardSteps.map((s, i) => <li><span>{i + 1}</span>{s}</li>)}
      </ol>
      <a class="hero__card-cta" href="#prueba" data-cta="hero-card">{c.cta1} →</a>
    </aside>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; background: #fff; border-bottom: 1px solid var(--line); padding-block: clamp(44px, 7vw, 96px) clamp(56px, 8vw, 104px); }
  .hero::after { content: ''; position: absolute; right: 0; top: 0; width: min(40vw, 520px); height: 100%; background: var(--bg); z-index: 0; }
  .hero__grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1.2fr .8fr; gap: clamp(32px, 6vw, 72px); align-items: center; }
  .hl { color: var(--navy); }
  .hero .lead { max-width: 600px; margin-bottom: 28px; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 26px; }
  .proof { display: flex; flex-wrap: wrap; gap: 10px 22px; list-style: none; padding: 0; margin: 0; font-size: .95rem; color: var(--ink); font-weight: 500; }
  .proof li { display: inline-flex; align-items: center; gap: 8px; }
  .proof :global(.ok) { width: 18px; height: 18px; color: var(--navy); }

  .hero__card { position: relative; overflow: hidden; background: var(--navy); color: #e7e8f6; border-radius: 24px; padding: clamp(28px, 4vw, 40px); box-shadow: var(--shadow-lg); }
  /* Franjas de la bandera: detalle decorativo en rojo */
  .stripes { position: absolute; right: -30px; bottom: 16px; width: 120px; height: 42px; background: repeating-linear-gradient(180deg, var(--red) 0 8px, transparent 8px 16px); opacity: .9; transform: rotate(-8deg); }
  .hero__card-t { position: relative; font-family: var(--font-head); font-weight: 700; font-size: 1.55rem; color: #fff; margin: 0 0 22px; max-width: 70%; line-height: 1.2; }
  .hero__card ol { list-style: none; padding: 0; margin: 0 0 26px; display: grid; gap: 14px; }
  .hero__card li { display: flex; align-items: center; gap: 14px; font-weight: 500; color: #fff; }
  .hero__card li span { flex: none; width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; border: 2px solid rgb(255 255 255 / .35); font-weight: 700; }
  .hero__card li:first-child span { background: var(--yellow); border-color: var(--yellow); color: var(--navy-deep); } /* único acento amarillo */
  .hero__card-cta { color: #fff; font-weight: 700; text-decoration: underline; text-decoration-color: rgb(255 255 255 / .4); text-underline-offset: 5px; }
  .hero__card-cta:hover { text-decoration-color: #fff; }

  @media (max-width: 900px) {
    .hero::after { display: none; }
    .hero__grid { grid-template-columns: 1fr; }
  }
</style>
