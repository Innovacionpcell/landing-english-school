---
import Icon from '../Icon.astro';
import { copy } from '../../config/copy';
const c = copy.method;
---
<section class="section section--navy" id="metodologia">
  <div class="container">
    <div class="section__head section__head--center">
      <p class="eyebrow">{c.eyebrow}</p>
      <h2>{c.title}</h2>
    </div>
    <ul class="labs">
      {c.labs.map((l) => (
        <li>
          <span class="labs__ic"><Icon name={l.icon} /></span>
          <h3>{l.t}</h3>
          <p>{l.d}</p>
        </li>
      ))}
    </ul>
    <p class="center"><a class="btn" href="#matricula" data-cta="method">{copy.hero.cta1}</a></p>
  </div>
</section>
<style>
  .labs { list-style: none; padding: 0; margin: 0 0 48px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .labs li { border: 1px solid rgb(255 255 255 / .18); border-radius: var(--radius); padding: clamp(24px, 3vw, 32px); background: rgb(255 255 255 / .04); }
  .labs__ic { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 14px; margin-bottom: 18px; color: var(--navy); background: #fff; }
  .labs__ic :global(svg) { width: 26px; height: 26px; }
  .labs p { color: #d6d8f0; margin: 0; }
  .center { text-align: center; margin: 0; }
  @media (max-width: 860px) { .labs { grid-template-columns: 1fr; } }
</style>
