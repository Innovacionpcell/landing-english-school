---
import Icon from '../Icon.astro';
import { copy } from '../../config/copy';
const c = copy.why;
const icons = ['chat', 'users', 'level', 'globe'];
---
<section class="section" id="por-que">
  <div class="container why">
    <div class="section__head why__head">
      <p class="eyebrow">{c.eyebrow}</p>
      <h2>{c.title}</h2>
      <p class="lead">{c.lead}</p>
    </div>
    <ul class="why__list">
      {c.points.map((p, i) => (
        <li class="card">
          <span class="why__ic"><Icon name={icons[i]} /></span>
          <h3>{p.k}</h3>
          <p>{p.v}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .why { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(32px, 6vw, 72px); align-items: start; }
  .why__head { margin: 0; position: sticky; top: 110px; }
  .why__list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .why__list p { margin: 0; color: var(--muted); }
  .why__ic { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 12px; background: var(--tint); color: var(--navy); margin-bottom: 16px; }
  .why__ic :global(svg) { width: 24px; height: 24px; }
  @media (max-width: 900px) { .why { grid-template-columns: 1fr; } .why__head { position: static; } }
  @media (max-width: 560px) { .why__list { grid-template-columns: 1fr; } }
</style>
