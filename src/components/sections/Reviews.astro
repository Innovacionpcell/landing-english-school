---
import Icon from '../Icon.astro';
import data from '../../data/reviews.json';
import { SITE } from '../../config/site';
import { t, type Lang } from '../../i18n/copy';
const { lang } = Astro.props as { lang: Lang };
const c = t(lang).reviews;
const all = (data.mapsUri as string | null) ?? SITE.mapsUrl;
const rating = data.rating.toLocaleString(lang === 'es' ? 'es-CO' : 'en-US', { minimumFractionDigits: 1 });
type R = { author: string; photo: string | null; rating: number; text: string; relativeTime: string };
const reviews = (data.reviews as R[]).slice(0, 6);
const initials = (n: string) => n.split(' ').map((p) => p[0]).slice(0, 2).join('').toUpperCase();
---
<section class="section" id="resenas">
  <div class="container">
    <div class="rv__head">
      <div>
        <p class="eyebrow">{c.eyebrow}</p>
        <h2>{c.title}</h2>
      </div>
      <div class="rv__score card">
        <Icon name="google" class="g" />
        <div>
          <p class="rv__num">{rating} <span class="stars" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Icon name="star" />)}</span></p>
          <p class="rv__base">{c.basedOn} {data.total} {c.reviews}</p>
        </div>
      </div>
    </div>

    {reviews.length > 0 && (
      <ul class="grid rv__list">
        {reviews.map((r) => (
          <li class="card rv">
            <div class="rv__who">
              {r.photo ? <img src={r.photo} alt="" width="40" height="40" loading="lazy" referrerpolicy="no-referrer" /> : <span class="av">{initials(r.author)}</span>}
              <div><strong>{r.author}</strong><span>{r.relativeTime}</span></div>
              <Icon name="google" class="g-sm" />
            </div>
            <span class="stars" role="img" aria-label={`${r.rating}/5`}>{Array.from({ length: r.rating }).map(() => <Icon name="star" />)}</span>
            <p>{r.text.length > 280 ? r.text.slice(0, 277) + '…' : r.text}</p>
          </li>
        ))}
      </ul>
    )}

    <div class="rv__ctas">
      <a class="btn btn--ghost" href={all} target="_blank" rel="noopener">{c.readAll}<Icon name="arrow" /></a>
      <a class="btn btn--ghost" href={SITE.reviewUrl} target="_blank" rel="noopener"><Icon name="star" class="y" />{c.write}</a>
    </div>
  </div>
</section>
<style>
  .rv__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; margin-bottom: 40px; }
  .rv__head h2 { margin: 0; max-width: 620px; }
  .rv__score { display: flex; align-items: center; gap: 16px; padding: 18px 24px; }
  .rv__score :global(.g) { width: 40px; height: 40px; }
  .rv__num { margin: 0; font-family: var(--font-head); font-weight: 800; font-size: 2rem; color: var(--ink); display: flex; align-items: center; gap: 10px; line-height: 1; }
  .rv__base { margin: 4px 0 0; color: var(--muted); font-size: .92rem; }
  .rv__list { grid-template-columns: repeat(3, 1fr); list-style: none; padding: 0; margin: 0 0 32px; }
  .rv p { margin: 12px 0 0; color: var(--ink-2); }
  .rv__who { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
  .rv__who img, .av { width: 40px; height: 40px; border-radius: 50%; flex: none; }
  .av { display: grid; place-items: center; background: #e8f0fe; color: var(--blue); font-weight: 700; font-family: var(--font-head); }
  .rv__who strong { display: block; color: var(--ink); line-height: 1.2; }
  .rv__who span { font-size: .85rem; color: var(--muted); }
  .rv__who :global(.g-sm) { width: 20px; height: 20px; margin-left: auto; }
  .rv__ctas { display: flex; gap: 12px; flex-wrap: wrap; }
  .rv__ctas :global(.y) { color: var(--yellow); }
  @media (max-width: 960px) { .rv__list { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 620px) { .rv__list { grid-template-columns: 1fr; } }
</style>
