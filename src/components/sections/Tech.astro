---
import { Image } from 'astro:assets';
import mockup from '../../assets/andres/social-scheduler-mockup.jpg';
import Icon from '../Icon.astro';
import { t, type Lang } from '../../i18n/copy';
const { lang } = Astro.props as { lang: Lang };
const c = t(lang).tech;
---
<section class="section" id="tecnologia">
  <div class="container tech">
    <div class="tech__media">
      <Image src={mockup} widths={[360, 540, 720]} sizes="(max-width: 900px) 92vw, 520px" alt={c.imgAlt} loading="lazy" class="tech__img" />
    </div>
    <div>
      <p class="eyebrow">{c.eyebrow}</p>
      <h2>{c.title}</h2>
      <p class="lead">{c.lead}</p>
      <ul class="tech__list">
        {c.items.map((it) => (
          <li><span class="ok"><Icon name="check" /></span><div><strong>{it.t}</strong><span>{it.d}</span></div></li>
        ))}
      </ul>
    </div>
  </div>
</section>
<style>
  .tech { display: grid; grid-template-columns: .95fr 1.05fr; gap: clamp(32px, 6vw, 80px); align-items: center; }
  .tech__media :global(.tech__img) { width: 100%; height: auto; border-radius: var(--radius); background: var(--bg-soft); }
  .tech__list { list-style: none; padding: 0; margin: 24px 0 0; display: grid; gap: 16px; }
  .tech__list li { display: flex; gap: 14px; }
  .tech__list strong { display: block; color: var(--ink); font-family: var(--font-head); }
  .tech__list span { color: var(--muted); }
  .ok { flex: none; width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; background: #e8f0fe; color: var(--blue); }
  .ok :global(svg) { width: 17px; height: 17px; }
  @media (max-width: 900px) { .tech { grid-template-columns: 1fr; } .tech__media { order: 2; } }
</style>
