---
import Icon from './Icon.astro';
import Brand from './Brand.astro';
import { copy } from '../config/copy';
const c = copy.nav;
const links = [
  { href: '/#programas', label: c.programs },
  { href: '/#por-que', label: c.why },
  { href: '/#metodologia', label: c.method },
  { href: '/#sedes', label: c.coverage },
  { href: '/#faq', label: c.faq },
];
---
<header class="hdr">
  <div class="container hdr__in">
    <a href="/" class="brand" aria-label="English School Medellín – inicio"><Brand /></a>
    <nav class="nav" id="nav" aria-label="Principal">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
      <a class="btn btn--sm" href="/#matricula" data-cta="header">{c.cta}</a>
    </nav>
    <button class="burger" type="button" aria-controls="nav" aria-expanded="false" aria-label={c.menu}>
      <Icon name="menu" />
    </button>
  </div>
</header>

<script>
  const b = document.querySelector<HTMLButtonElement>('.burger');
  const n = document.getElementById('nav');
  b?.addEventListener('click', () => {
    const open = b.getAttribute('aria-expanded') === 'true';
    b.setAttribute('aria-expanded', String(!open));
    n?.classList.toggle('is-open', !open);
  });
  n?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) { n.classList.remove('is-open'); b?.setAttribute('aria-expanded', 'false'); }
  });
</script>

<style>
  .hdr { position: sticky; top: 0; z-index: 50; background: rgb(255 255 255 / .9); backdrop-filter: saturate(180%) blur(14px); -webkit-backdrop-filter: saturate(180%) blur(14px); border-bottom: 1px solid var(--line); }
  .hdr__in { display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 72px; }
  .brand { text-decoration: none; }
  .nav { display: flex; align-items: center; gap: 22px; }
  .nav .btn { white-space: nowrap; }
  .nav ul { display: flex; gap: 22px; list-style: none; margin: 0; padding: 0; }
  .nav ul a { color: var(--ink); text-decoration: none; font-weight: 500; font-size: .96rem; }
  .nav ul a:hover { color: var(--navy); text-decoration: underline; text-decoration-color: var(--red); text-decoration-thickness: 2px; }
  .burger { display: none; background: none; border: 0; padding: 10px; margin-right: -10px; color: var(--navy-deep); cursor: pointer; }
  @media (max-width: 1020px) {
    .burger { display: inline-flex; }
    .nav { position: fixed; inset: 72px 0 auto 0; flex-direction: column; align-items: stretch; gap: 14px; padding: 20px var(--gutter) 28px; background: #fff; border-bottom: 1px solid var(--line); box-shadow: var(--shadow); transform: translateY(-8px); opacity: 0; visibility: hidden; transition: .2s ease; }
    .nav.is-open { transform: none; opacity: 1; visibility: visible; }
    .nav ul { flex-direction: column; gap: 4px; }
    .nav ul a { display: block; padding: 12px 0; font-size: 1.05rem; }
  }
</style>
