---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { whatsappUrl } from '../config/site';
import { copy } from '../config/copy';
const c = copy.thanks;
---
<Base title={c.metaTitle} description={c.lead} noindex>
  <section class="section th">
    <div class="container th__in">
      <span class="th__ok"><Icon name="check" /></span>
      <h1>{c.title}</h1>
      <p class="lead">{c.lead}</p>
      <p class="th__ctas">
        <a class="btn" href={whatsappUrl('Hola, acabo de enviar el formulario para la prueba de nivel')} target="_blank" rel="noopener" data-cta="thanks-wa"><Icon name="whatsapp" />{copy.wa}</a>
        <a class="btn btn--ghost" href="/">← {c.back}</a>
      </p>
    </div>
  </section>
  <script>
    // Evento de conversión para Google Ads / GA4 (vía GTM)
    (window as any).dataLayer = (window as any).dataLayer || [];
    (window as any).dataLayer.push({ event: 'lead_thank_you' });
  </script>
</Base>
<style>
  .th__in { text-align: center; max-width: 720px; }
  .th__in h1 { font-size: clamp(2rem, 4.4vw, 3rem); }
  .th__ok { display: inline-grid; place-items: center; width: 64px; height: 64px; border-radius: 50%; background: var(--tint); color: var(--navy); margin-bottom: 18px; }
  .th__ok :global(svg) { width: 34px; height: 34px; }
  .th__ctas { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-top: 12px; }
</style>
