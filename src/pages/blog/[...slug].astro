---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { SITE } from '../../config/site';
import { t, type Lang } from '../../i18n/copy';
import { graph, organizationGraph, blogPosting, breadcrumb } from '../../lib/schema';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const { Content } = await render(post);
const lang = post.data.lang as Lang;
const c = t(lang);
const url = `${SITE.url}/blog/${post.id}/`;
// Portada local → OG optimizada 1200×630. Portada remota (artículos automáticos) → se usa la URL tal cual (no rompe el build si el CDN falla)
const remoteCover = typeof post.data.cover === 'string' ? post.data.cover : null;
const og = post.data.cover && !remoteCover ? await getImage({ src: post.data.cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' }) : null;
const ogSrc = remoteCover ?? og?.src ?? '/og-growth-digital.jpg';
const date = post.data.pubDate.toLocaleDateString(lang === 'es' ? 'es-CO' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const schema = graph(
  organizationGraph(lang),
  blogPosting({ url, title: post.data.title, description: post.data.description, image: new URL(ogSrc, SITE.url).href, pub: post.data.pubDate, upd: post.data.updatedDate, lang, tags: post.data.tags }),
  breadcrumb([{ name: 'Inicio', url: `${SITE.url}/` }, { name: 'Blog', url: `${SITE.url}/blog/` }, { name: post.data.title, url }]),
);
---
<Base lang={lang} title={`${post.data.title} | Growth Digital`} description={post.data.description} type="article" image={ogSrc} schema={schema}>
  <article class="section post">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Inicio</a> / <a href="/blog/">Blog</a></nav>
      <header class="post__head">
        <p class="eyebrow">{post.data.category}</p>
        <h1>{post.data.title}</h1>
        <p class="lead">{post.data.description}</p>
        <p class="post__by">
          <a href="/#sobre-mi">{SITE.founder.shortName}</a> · <time datetime={post.data.pubDate.toISOString()}>{date}</time>
        </p>
      </header>
      {remoteCover ? (
        <img src={remoteCover} alt={post.data.coverAlt ?? ''} width="1600" height="666" loading="eager" fetchpriority="high" decoding="async" class="post__cover" />
      ) : post.data.cover && (
        <Image src={post.data.cover} alt={post.data.coverAlt ?? ''} widths={[480, 800, 1100]} sizes="(max-width: 1180px) 94vw, 1100px" loading="eager" fetchpriority="high" class="post__cover" />
      )}
      <div class="prose"><Content /></div>
      <aside class="post__cta card">
        <h2>{c.contact.title}</h2>
        <p>{c.contact.lead}</p>
        <a class="btn" href={lang === 'es' ? '/#agenda' : '/en/#agenda'} data-cta="blog-post"><Icon name="calendar" />{c.hero.cta1}</a>
      </aside>
    </div>
  </article>
</Base>
<style>
  .post { padding-top: clamp(32px, 5vw, 56px); }
  .crumbs { font-size: .9rem; color: var(--muted); margin-bottom: 24px; max-width: 820px; margin-inline: auto; }
  .crumbs a { color: var(--muted); }
  .post__head { max-width: 820px; margin: 0 auto 32px; }
  .post__head h1 { font-size: clamp(2rem, 4.4vw, 3.1rem); }
  .post__by { color: var(--muted); font-size: .95rem; }
  .post :global(.post__cover) { width: 100%; max-width: 1100px; margin: 0 auto 48px; aspect-ratio: 1600 / 666; object-fit: cover; border-radius: var(--radius); }
  .post__cta { max-width: 820px; margin: 64px auto 0; text-align: center; background: linear-gradient(135deg, #e8f0fe, #fff 60%); }
  .post__cta h2 { font-size: 1.6rem; }
</style>
