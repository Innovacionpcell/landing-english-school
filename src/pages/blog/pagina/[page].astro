---
import BlogIndex, { PER_PAGE, allPosts } from '../../../components/BlogIndex.astro';
// Páginas 2..N del blog (la 1 es /blog/). 18 artículos por página = 3 columnas × 6 filas.
export async function getStaticPaths() {
  const total = Math.ceil((await allPosts()).length / PER_PAGE);
  return Array.from({ length: Math.max(0, total - 1) }, (_, i) => ({ params: { page: String(i + 2) }, props: { page: i + 2 } }));
}
const { page } = Astro.props as { page: number };
---
<BlogIndex page={page} />
